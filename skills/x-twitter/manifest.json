{
  "name": "x-twitter",
  "version": "1.0.0",
  "owner": "github:sonichi/sutando",
  "license": "MIT",
  "stability": "stable",
  "description": "Post tweets, search, read mentions, and check engagement on X (Twitter) via API v2.",
  "access_tier": "owner",
  "enabled": true,
  "permissions": {
    "network": true,
    "filesystem": "read-write",
    "secrets": "none"
  },
  "config": {
    "X_BROWSER_PROFILE": "",
    "X_LOGIN_DONE_SENTINEL": "/tmp/x-login-done",
    "X_LOGIN_TIMEOUT_ITERS": "120",
    "X_PROFILE_GRACE_MS": "10000"
  },
  "provenance": {
    "source_repo": "https://github.com/sonichi/sutando"
  }
}
