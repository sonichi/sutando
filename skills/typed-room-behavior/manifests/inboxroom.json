{
  "$schema": "../behavior-manifest.schema.json",
  "type": "inboxroom",
  "version": 1,
  "entity": "InboxItem",
  "state_model": "drain-queue",
  "data_object": {
    "folder": "inboxroom",
    "filename": "items.json"
  },
  "analyze": {
    "module": "skills/inboxroom/inbox-command.py",
    "function": "items_needing_attention"
  },
  "autonomy_default": "safe",
  "cooldown_s": 10800,
  "tiers": {
    "safe": {
      "reasons": [],
      "actions": []
    },
    "advance": {
      "reasons": [
        "high-priority",
        "unread",
        "unassigned"
      ],
      "reason_prefixes": [
        "stale_"
      ],
      "verbs": {
        "unread": "`triage {name}`",
        "unassigned": "`assign {name} to <who>`",
        "high-priority": "`resolve {name}` when handled",
        "default": "`note {name}: ...`"
      }
    }
  }
}