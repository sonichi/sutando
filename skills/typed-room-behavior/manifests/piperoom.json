{
  "$schema": "../behavior-manifest.schema.json",
  "type": "piperoom",
  "version": 1,
  "entity": "PipelineEntry",
  "state_model": "linear-stages",
  "data_object": { "folder": "piperoom", "filename": "pipeline.json" },
  "analyze": { "module": "skills/piperoom/piperoom-command.py", "function": "items_needing_attention" },
  "autonomy_default": "safe",
  "cooldown_s": 10800,
  "tiers": {
    "safe": {
      "reasons": ["needs_enrich", "missing_contact", "thin_no_notes"],
      "actions": [
        {
          "name": "enrich",
          "effect": "additive",
          "tool": { "hub_slug": "lead-enricher", "tool": "enrich_leads" },
          "requires": "linkedin_url_in_notes",
          "max_per_pass": 3
        }
      ]
    },
    "advance": {
      "reason_prefixes": ["stale_"],
      "reasons": [],
      "verbs": {
        "stale_*": "`/update {name}: <what happened>` or `move {name} to <stage>`",
        "default": "`/enrich {name}` or `/update {name}: ...`"
      }
    }
  }
}
