<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sutando — phone-stack watchdog launchd job (template).

  Do NOT load directly: `bash src/install-phone-watchdog-launchd.sh` must first
  substitute __REPO__, __WORKSPACE__ and __HOMEBREW_BIN__ with real paths.
  KeepAlive is omitted on purpose — this is an exit-only job that launchd re-runs
  on StartInterval, so a persistent process would defeat the interval.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sutando.phone-watchdog</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO__/src/phone-watchdog.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <key>StartInterval</key>
    <integer>120</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>120</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__HOMEBREW_BIN__:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>__WORKSPACE__/logs/phone-watchdog-launchd.log</string>

    <key>StandardErrorPath</key>
    <string>__WORKSPACE__/logs/phone-watchdog-launchd.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
