<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>__LABEL__</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/src/launchd/channel-bridge-wrapper.sh</string>
    <string>__CHANNEL__</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__BREW_BIN__:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key><string>__HOME__</string>
    <key>SUTANDO_WORKSPACE</key><string>__WORKSPACE__</string>
    <key>SUTANDO_REPO_DIR</key><string>__REPO__</string>
    <key>CLAUDE_CONFIG_DIR</key><string>__CLAUDE_CONFIG_DIR__</string>
  </dict>
  <key>StandardOutPath</key><string>__WORKSPACE__/logs/__CHANNEL__-bridge.log</string>
  <key>StandardErrorPath</key><string>__WORKSPACE__/logs/__CHANNEL__-bridge.log</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
