{
  "_comment": "Copy this file to sutando.config.local.json and edit. Everything is optional — omit any field to fall through to the default in sutando.config.json. The .local.json file is gitignored.",

  "core": {
    "_comment": "Persistent task-execution CLI. Set codex for Codex CLI or omit this block to keep the default claude runtime.",
    "runtime": "codex",
    "_comment_expected_branch": "Branch the live checkout should stay on (default main). Set on hosts intentionally pinned elsewhere (e.g. dual-run pinned nodes) so health-check's live-checkout-branch probe honors the pin across restarts; SUTANDO_EXPECTED_BRANCH overrides per-invocation.",
    "expected_branch": "main",
    "_comment_checkout_behind_warn": "Commits behind origin/<expected_branch> before health-check warns the live checkout is STALE (default 10). Being on the right branch is only half of being current. Not 1 on purpose: main moves several times a day and a probe that fires on every delta is one the reader learns to skip. Invalid/zero/negative fall back to 10; there is no env-var override.",
    "checkout_behind_warn": 10
  },

  "sandbox": {
    "_comment": "Read-only sandbox that answers non-owner (team/other) tasks. Default codex. Set gemini on an install without Codex CLI: needs the gemini CLI on PATH and GEMINI_API_KEY (or other gemini auth) in .env. SUTANDO_SANDBOX_RUNTIME overrides per-invocation.",
    "runtime": "gemini"
  },

  "workspace": {
    "_comment": "Override the workspace location. Default is ${REPO_DIR}/workspace (in-repo). Set this only if you want the workspace outside the repo (e.g. on a different volume).",
    "path": "/absolute/path/to/your/workspace"
  },

  "vault": {
    "_comment": "Enable + point at your private remote git repo to sync notes/memory/archives off-host.",
    "enabled": true,
    "remote_url": "https://vault.example.com/<your-user>/workspace.git",
    "_comment_sync": "Override the default include/exclude lists from sutando.config.json if you want a different sync surface on this host.",
    "sync": {
      "include": [
        "notes/",
        "hosts/*/",
        "memory/"
      ]
    }
  }
}
