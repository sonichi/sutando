#!/usr/bin/env bash
# Sutando pre-commit hook: refuse commits that include workspace/ contents.
#
# The in-repo workspace at `<repo>/workspace/` holds per-user runtime state
# (tasks, results, notes, state, logs, etc.) that must NEVER be committed
# to the shared repo. The .gitignore (workspace/* with !workspace/.gitkeep)
# is the first line of defense; this hook is the second — it catches:
#
#   • git add -f workspace/foo.txt           (force-add bypasses .gitignore)
#   • git add workspace/data.json            (explicit add of a "skip" path
#                                              that gitignore would have skipped
#                                              under `git add .` but not under
#                                              an explicit pathspec)
#   • IDEs / AI assistants that stage files without consulting .gitignore
#
# Installation (per-clone, one-time):
#   git config core.hooksPath .githooks
#
# Or copy/symlink: ln -s ../../.githooks/pre-commit .git/hooks/pre-commit
#
# Escape hatch (for the rare case you really need to commit something under
# workspace/ — e.g. updating .gitkeep itself, or shipping a doc):
#   git commit --no-verify
#
# Whitelist (paths that ARE allowed to be committed under workspace/):
#   • workspace/.gitkeep      — required so the directory ships on fresh clone
#
# Exit non-zero refuses the commit; exit 0 lets it through.

set -euo pipefail

# Staged paths added or modified in this commit. We check both A (added) and
# M (modified) because a file could be added in an earlier commit and modified
# in this one — still want to refuse if it's under workspace/.
staged="$(git diff --cached --name-only --diff-filter=AMRC)"  # AMRC: a `git mv` into workspace/ registers as R and bypassed the AM gate

# Filter to paths under workspace/, then drop the allowed whitelist entries.
# `|| true` so grep's exit-1-on-no-match doesn't kill the script under set -e.
offenders="$(printf '%s\n' "$staged" \
  | grep -E '^workspace/' \
  | grep -vxF 'workspace/.gitkeep' \
  || true)"

if [[ -n "$offenders" ]]; then
  printf '\n\033[31m✖ pre-commit refusing: workspace/ contents must not be committed.\033[0m\n\n'
  printf 'The following staged paths live under workspace/, which holds per-user runtime\n'
  printf 'state (tasks, results, notes, state, logs). Move them out of workspace/ before\n'
  printf 'committing, or unstage them with: git reset HEAD <path>\n\n'
  printf '%s\n' "$offenders" | sed 's/^/  /'
  printf '\nIf you really need to commit this (e.g. updating workspace/.gitkeep itself),\n'
  printf 'pass --no-verify to git commit. Use sparingly.\n\n'
  exit 1
fi

# ---------------------------------------------------------------------------
# ruff pre-filter for staged Python.
#
# CI runs `ruff check .` and it is a required check. Three PRs in one session
# passed their whole test suite and then failed CI on ruff alone (E401, a
# two-second fix), each costing a push/CI/fix cycle. The failure mode is not
# carelessness — it is that the check only existed remotely.
#
# Deliberately a PRE-FILTER, not an authority:
#
#   • FAIL-OPEN when no ruff is installed. A contributor without the tool must
#     never be blocked from committing; CI remains the gate that decides.
#   • Lints the STAGED BLOB, not the working tree. `--stdin-filename` keeps the
#     path so ruff.toml still resolves, while the bytes are the ones actually
#     being committed; linting the worktree would both miss violations you
#     staged and block on ones you did not.
#   • Only files staged in THIS commit, so a pre-existing violation elsewhere
#     never blocks unrelated work.
#   • Local ruff may differ from the version CI pins; a disagreement is CI's to
#     settle. This catches the obvious case before the push, not to mirror CI.
#
# Escape hatch, same as above: git commit --no-verify
# ---------------------------------------------------------------------------

staged_py="$(printf '%s\n' "$staged" | grep -E '\.py$' || true)"

if [[ -n "$staged_py" ]]; then
  ruff_cmd=""
  if command -v ruff >/dev/null 2>&1; then
    ruff_cmd="ruff"
  elif command -v uvx >/dev/null 2>&1; then
    ruff_cmd="uvx ruff"
  elif command -v uv >/dev/null 2>&1; then
    ruff_cmd="uv tool run ruff"
  fi

  if [[ -z "$ruff_cmd" ]]; then
    printf '\033[33m~ pre-commit: no ruff found locally; skipping lint pre-filter (CI still checks).\033[0m\n' >&2
  else
    # Findings and failures are DIFFERENT STREAMS with different exit codes, and
    # conflating them is what made an earlier version of this hook refuse clean
    # commits whenever the runner itself was broken:
    #
    #   rc 0            no findings
    #   rc 1 + stdout   real lint findings          -> refuse
    #   rc >= 2         config/flag/download/cache failure, message on STDERR
    #   rc 1 + NO stdout   a runner that errored but exited 1 anyway
    #
    # Only the second case is a finding. Everything else is the runner failing to
    # RUN, which must fail open exactly like "no ruff installed" — CI is the
    # authority, and a local toolchain problem must never block a clean commit.
    ruff_out=""
    runner_err=""
    # Newline-safe, NOT `for f in $staged_py`. Word-splitting turns a staged
    # path like `scripts/my check.py` into two nonexistent paths (and glob-
    # expands `*`/`?`); `git show` then fails, which this loop classifies as a
    # RUNNER error and fails open — so a filename with a space silently skips
    # linting entirely. That is a false clean introduced by the fail-open fix
    # itself, which is exactly the shape this hook exists to prevent.
    while IFS= read -r f; do
      [[ -n "$f" ]] || continue
      out_f="$(mktemp)"; err_f="$(mktemp)"
      # `|| rc=$?` is load-bearing twice over: this file runs under `set -e`
      # (line 30), so a nonzero runner would abort the hook before the status
      # could be read — the hook exited 2 and printed nothing. It also captures
      # the code, which a bare `|| true` would discard (the original defect).
      rc=0
      git show ":$f" 2>/dev/null | $ruff_cmd check --stdin-filename "$f" - >"$out_f" 2>"$err_f" || rc=$?
      out="$(cat "$out_f")"; err="$(cat "$err_f")"
      rm -f "$out_f" "$err_f"
      if [[ "$rc" -eq 0 ]]; then
        continue                                  # clean
      elif [[ "$rc" -eq 1 && -n "${out// }" ]]; then
        ruff_out+="$out"$'\n'                     # genuine findings
      else
        runner_err="${err:-$out}"                 # the runner could not run
        break
      fi
    done <<< "$staged_py"

    if [[ -n "${runner_err// }" ]]; then
      printf '\033[33m~ pre-commit: ruff could not run (%s); skipping lint pre-filter — CI still checks.\033[0m\n' \
        "$(printf '%s' "$runner_err" | head -1 | cut -c1-100)" >&2
      ruff_out=""
    fi

    if [[ -n "${ruff_out// }" ]]; then
      printf '\n\033[31m✖ pre-commit refusing: ruff findings in staged Python.\033[0m\n\n'
      printf '%s\n' "$ruff_out"
      printf 'Fix them, or re-run the check yourself with:\n'
      printf '  %s check .\n\n' "$ruff_cmd"
      printf 'If this is a false positive or a local/CI version disagreement,\n'
      printf 'pass --no-verify to git commit and let CI adjudicate.\n\n'
      exit 1
    fi
  fi
fi

exit 0
