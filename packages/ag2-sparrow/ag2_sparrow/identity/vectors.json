{
  "comment": "Deterministic vectors for the B1 identity contract. Same inputs must yield exactly these strings on every host, every run. Changing an expected value is a contract change and needs the owner per the freeze doc.",
  "vectors": [
    {"kind": "ingress_task_id", "args": ["inst7", "9f3ab2"], "expected": "task-inst7~9f3ab2"},
    {"kind": "ingress_task_id", "args": ["inst~7", "ev@nt:1"], "expected": "task-inst%7E7~ev%40nt%3A1"},
    {"kind": "delivery_id", "args": ["task-1712000000001", "discord-dm"], "expected": "d:task-1712000000001@discord-dm"},
    {"kind": "legacy_delivery_id", "args": ["task-1712000000001", "discord-dm"], "expected": "legacy:task-1712000000001@discord-dm"},
    {"kind": "legacy_delivery_id", "args": ["proactive-99.txt#171200000", "discord-proactive"], "expected": "legacy:proactive-99.txt%23171200000@discord-proactive"},
    {"kind": "resend_delivery_id", "args": ["d:task-1712000000001@discord-dm", 1], "expected": "d:task-1712000000001@discord-dm+r1"},
    {"kind": "attempt_id", "args": ["d:task-1712000000001@discord-dm", 3], "expected": "d:task-1712000000001@discord-dm#a3"},
    {"kind": "idempotency_key", "args": ["task-1712000000001", "discord-dm"], "expected": "e:task-1712000000001@discord-dm"},
    {"kind": "incarnation_id_from", "args": ["worker-2", 4242, 1712000000123456], "expected": "worker-2:4242:1712000000123456"}
  ]
